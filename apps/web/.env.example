# Reads equipment nameplates from photos (the Equipment screen). Without it the
# screen still works: photos are saved and the fields are filled in by hand.
# Put the real key in .env.local, which is not committed.
ANTHROPIC_API_KEY=
# Optional: override the model used to read nameplates.
# ANTHROPIC_MODEL=claude-opus-5

# Technician logins. Do not edit by hand: `pnpm tech add Juan Perez` writes
# both of these into .env.local and prints the new login's PIN.
# MANIFOLD_TECHNICIANS=
# MANIFOLD_SESSION_SECRET=

# ServiceTitan. The four values come from the company's ServiceTitan admin
# (Settings > Integrations > API Application Access) and the developer portal.
# Without them, the ServiceTitan features stay hidden.
# ST_TENANT_ID=
# ST_APP_KEY=
# ST_CLIENT_ID=
# ST_CLIENT_SECRET=
# mock = demo data, nothing leaves the PC; integration = ServiceTitan's test
# environment; leave unset for the real ServiceTitan.
# ST_MODE=mock
